      "outputs": {
        "clean_two_channel_dir": ""
      },
      "steps": {
        "music_analysis": true,
        "music_removal": true,
        "cut_music": true,
        "diarization": true,
        "separation": true,
        "asr": true,
        "captioning": false,
        "refinement": true,
        "speaker_relabel": true,
        "word_alignment": true,
        "conversation_exports": true,
        "export": true
      },
      "pipeline": {
        "vad": true,
        "bss": true,
        "music": true,
        "music_scope": "spans",
        "ASRMoE": true,
        "llm_refinement": true,
        "qwen3omni": false,
        "dia3": false,
        "keep_models": false,
        "prefetch_workers": false,
        "by_stage": true,
        "review_page": true,
        "review_max_mb": 400,
        "initprompt": true,
        "lang": "vi",
        "LLM": "case_0",
        "merge_gap": 0.8,
        "bridge_gap": 3.0,
        "max_segment_length": 20.0,
        "seg_th": 0.11,
        "min_cluster_size": 11,
        "clust_th": 0.5
      },
      "models": {
        "vad": {
          "vad_threshold": 2.0,
          "max_segment": 20.0
        },
        "whisper": {
          "model_size": "large-v3",
          "compute_type": "float16",
          "batch_size": 16
        },
        "phowhisper": {
          "compute_type": "float16",
          "batch_size": 16
        },
        "qwen3": {
          "batch_size": 6,
          "use_flash_attention": false,
          "torch_dtype": "float16"
        },
        "diarizen": {
          "batch_size": 12,
          "seg_duration": 16,
          "segmentation_step": 0.1,
          "apply_median_filtering": true,
          "clustering_method": "VBxClustering",
          "min_speakers": 1,
          "max_speakers": 10,
          "ahc_threshold": 0.62
        },
        "bss": {
          "qc_sim_threshold": 0.2,
          "min_voiced_sec": 1.0,
          "context_per_side_seconds": 2.0,
          "context_max_per_side_seconds": 2.2,
          "padding_min_per_speaker_seconds": 1.0,
          "boundary_search_seconds": 1800.0,
          "enrollment_memory": false,
          "separator": "sidon",
          "embedding_repository": "Wespeaker/wespeaker-voxceleb-resnet293-LM",
          "embedding_filename": "voxceleb_resnet293_LM.onnx"
        },
        "bs_roformer": {
          "model": "mel_band_roformer_kim_ft2_bleedless_unwa.ckpt",
          "chunk_duration": 300,
          "normalization_threshold": 1.0,
          "native_fp16": false,
          "torch_compile": false,
          "hi_res": true
        },
        "refinement": {
          "model_name": "Qwen/Qwen2.5-3B-Instruct",
          "batch_size": 2,
          "torch_dtype": "bfloat16",
          "prefix_cache": false
        },
        "relabel": {
          "window_tokens": 6000,
          "overlap_segments": 30,
          "min_confidence": 0.7,
          "max_change_fraction": 0.15,
          "thinking": false
        },
        "word_alignment": {
          "model_name": "nguyenvulebinh/wav2vec2-base-vi-vlsp2020",
          "device": "auto",
          "interpolate_method": "nearest",
          "batch_seconds": 180
        },
        "conversation_selection": {
          "min_seconds": 60,
          "max_seconds": 240,
          "max_silence": 3.0,
          "max_monologue": 0,
          "min_turns_each": 1,
          "min_score": 55,
          "min_semantic": 4,
          "max_candidates": 24,
          "pad_seconds": 0.2,
          "fade_ms": 50,
          "stereo": true,
          "overlap_first": true,
          "overlap_min_seconds": 0.3,
          "overlap_good_min_similarity": 0.6,
          "overlap_good_min_coverage": 0.9,
          "require_noise": true,
          "require_semantic": true,
          "noisy_run_seconds": 2.0,
          "noise_speech_max": 0.1,
          "noise_env_max": 0.15,
          "noise_room_max": 0.1,
          "noise_max": 0.15,
          "music_patched_max": 0.15,
          "require_word_alignment": true,
          "thinking": false
        },
        "sidon": {
          "num_steps": 100
        }
      },
      "allow_tf32": true,
      "performance": {
        "enabled": true,
        "max_gpus": 2,
        "gpu_reserve_gib": 2.0,
        "cpu_reserve_for_coordinator": 1,
        "ram_soft_fraction": 0.75,
        "ram_hard_fraction": 0.85,
        "max_pending_jobs": 32,
        "telemetry_interval_seconds": 1.0,
        "stages": {
          "asr": {
            "true_batching": true,
            "dynamic_replicas": true,
            "max_replicas_per_model": 2,
            "replica_min_pending_jobs": 12,
            "replica_min_gain_seconds": 15.0,
            "replica_load_seconds": 30.0,
            "replica_speed_ratio": 0.5
          },
          "refinement": {
            "workers": 2,
            "placement": "pipelined",
            "gpu_memory_utilization": 0.82,
            "max_batch_tokens": 8192,
            "micro_batch_size": 1,
            "pipeline_split_ratio": 0.5,
            "cpu_threads": 8
          },
          "diarization": {
            "workers": 2,
            "placement": "replicated"
