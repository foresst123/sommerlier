                }
            },
            "allow_tf32": true,
            "batch": {
                "max_hours_per_run": 20.0
            }
        }
    },
    "batch": {
        "max_hours_per_run": 5.0,
        "audio_extensions": [
            ".mp3",
            ".wav",
            ".m4a",
            ".flac",
            ".opus",
            ".ogg",
            ".aac"
