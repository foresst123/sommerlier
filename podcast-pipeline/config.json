          "separation": {
            "max_workers": 2,
            "gpu_prefetch_per_worker": 2,
            "postprocess_workers": 2,
            "postprocess_device": "cpu",
            "ordered_postprocess": true
          },
          "music": {
            "tagger_workers": 1,
            "max_separator_workers": 2,
            "cross_file_overlap": false,
            "ordered_postprocess": true,
            "postprocess_workers": 2
          }
        }
      },
