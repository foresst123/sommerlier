{
    "language": {
        "multilingual": false,
        "supported": [
            "en",
            "ko",
            "ja",
            "zh",
            "es",
            "fr",
            "de",
            "it",
            "pt",
            "ru",
            "ar",
            "hi"
        ]
    },
    "entrypoint": {
        "input_folder_path": "audio_pipeline/test",
        "SAMPLE_RATE": 16000
    },
    "huggingface_token": "hf_XXXXXXXXXXXXXXXXXXXXXXXX",
    "environments": {
        "kaggle": {
            "offline_mode": false,
            "gpu_1": 0,
            "gpu_2": 1,
            "pipeline": {
                "merge_gap": 1.0,
                "seg_th": 0.11,
                "min_cluster_size": 11,
                "clust_th": 0.5
            },
            "models": {
                "whisper": {
                    "model_size": "large-v3-turbo",
                    "compute_type": "float16",
                    "batch_size": 16
                },
                "qwen3": {
                    "batch_size": 4,
                    "use_flash_attention": false,
                    "torch_dtype": "float16"
                },
                "diarizen": {
                    "batch_size": 12,
                    "seg_duration": 16,
                    "segmentation_step": 0.05,
                    "apply_median_filtering": false,
                    "clustering_method": "VBxClustering",
                    "min_speakers": 1,
                    "max_speakers": 20,
                    "ahc_threshold": 0.6
                },
                "demucs": {
                    "segment": 10,
                    "overlap": 0.1
                }
            }
        },
        "notebook": {
            "offline_mode": true,
            "offline_weights_dir": "./offline_weights",
            "gpu_1": 0,
            "gpu_2": 0,
            "pipeline": {
                "merge_gap": 1.0,
                "seg_th": 0.11,
                "min_cluster_size": 11,
                "clust_th": 0.5
            },
            "models": {
                "whisper": {
                    "model_size": "large-v3-turbo",
                    "compute_type": "bfloat16",
                    "batch_size": 64
                },
                "qwen3": {
                    "batch_size": 16,
                    "use_flash_attention": true,
                    "torch_dtype": "bfloat16"
                },
                "diarizen": {
                    "batch_size": 128,
                    "seg_duration": 16,
                    "segmentation_step": 0.05,
                    "apply_median_filtering": false,
                    "clustering_method": "VBxClustering",
                    "min_speakers": 1,
                    "max_speakers": 20,
                    "ahc_threshold": 0.6
                },
                "demucs": {
                    "segment": 20,
                    "overlap": 0.25
                }
            }
        }
    },
    "batch": {
        "max_hours_per_run": 5.0,
        "audio_extensions": [
            ".mp3",
            ".wav",
            ".m4a",
            ".flac",
            ".opus",
            ".ogg",
            ".aac"
        ]
    }
}