# Result dumps pulled back from a run: kaggle/, "kaggle 2", "kaggle 3", ...
# One pattern rather than a line per download -- a space in a pattern is a
# literal character, so "kaggle *" never matched anything.
kaggle*/
new_data_run/

# A/B listening samples generated to check the spectral EQ by ear. Audio,
# regenerated on demand from the run output -- never source.
podcast-pipeline/eq_samples/

# Same idea for the inpainting comparison: tools/try_inpaint.py --dump writes
# mixture/sidon/bridge per span so the two methods can be judged by ear.
podcast-pipeline/inpaint_samples/

# PANNs raw dumps: binary, regenerable with tools/dump_panns.py
data/panns/*.npz
data/panns/*.csv

# Kết quả chạy tải về: nặng (review HTML ~107MB/file) và có repo lồng bên trong
results/

# Playwright MCP scratch output
.playwright-mcp/

# Subagent-driven-development scratch: per-plan ledgers, briefs, review
# packages. Git history is the record once a plan finishes; this is working
# state for the run itself.
.superpowers/

# Thư viện dùng riêng để chạy kiểm thử trên máy này.
.test-deps/

# Kaggle run artifacts pulled back for analysis: a notebook exported with its
# output cells (~1MB of log) and the telemetry the performance monitor writes.
# They belong to one run, not to the code. Notebooks meant to be kept live in
# notebooks/, so only the repo root is ignored here.
/notebook*.ipynb
/performance_summary.json
/scheduler_events.jsonl
/resource_samples.jsonl

# Pipeline stdout logs saved from a run (main_GPU<ids>-<time>.log), repo root only.
/main_GPU*.log
# Loose patch files kept at the repo root while porting changes; not part of the code.
/*.patch
